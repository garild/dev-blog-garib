@{
    var siteTitle = Context.Settings.GetString("Title") ?? "Garib Tigranyan | Engineering Notes";
    var title = Document.GetString("Title") ?? "Engineering Notes";
    var description = Document.GetString("Description") ?? Context.Settings.GetString("Description") ?? "Practical .NET and software architecture notes.";
    var root = (Context.Settings.GetString("SiteBasePath") ?? "/dev-blog-garib").TrimEnd('/');
    var fullTitle = title == "Home" ? siteTitle : $"{title} | Garib Tigranyan";
}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#090914" />
  <meta name="description" content="@description" />
  <meta property="og:title" content="@fullTitle" />
  <meta property="og:description" content="@description" />
  <meta property="og:site_name" content="Garib Tigranyan · Engineering Notes" />
  <meta property="og:type" content="website" />
  <title>@fullTitle</title>
  <link rel="icon" type="image/svg+xml" href="@(root)/assets/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="@(root)/assets/css/site.css" />
  <script src="@(root)/assets/js/site.js" defer></script>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <div class="site-wrap">
    <header class="site-header"><div class="container header-content">
      <a class="logo" href="@(root)/" aria-label="Garib Tigranyan home"><span class="logo-mark">G<span>.</span></span><span>garib<span class="logo-accent">/</span>engineering</span></a>
      <button class="menu-toggle" type="button" aria-controls="primary-nav" aria-expanded="false" aria-label="Toggle menu"><span></span><span></span><span></span></button>
      <nav id="primary-nav" class="nav" aria-label="Primary navigation">
        <a href="@(root)/">Home</a><a href="@(root)/blog/">Articles</a><a href="@(root)/projects/">Projects</a><a href="@(root)/videos/">Videos</a><a href="@(root)/about/">About</a>
        <a class="nav-cta" href="@(root)/blog/">Start reading <span aria-hidden="true">↗</span></a>
      </nav>
    </div></header>
    <main id="main">@RenderBody()</main>
    <footer class="site-footer"><div class="container footer-top">
      <div><a class="logo" href="@(root)/"><span class="logo-mark">G<span>.</span></span><span>garib<span class="logo-accent">/</span>engineering</span></a><p>Clear thinking about architecture, code, and production engineering.</p></div>
      <div class="footer-navigation"><a href="@(root)/blog/">Articles</a><a href="@(root)/projects/">Projects</a><a href="@(root)/videos/">Videos</a><a href="@(root)/about/">About</a><a href="https://www.youtube.com/%40GaribTigranyan" target="_blank" rel="noopener noreferrer">YouTube ↗</a></div>
    </div><div class="container footer-bottom"><span>© @DateTime.UtcNow.Year Garib Tigranyan. All rights reserved.</span><span>Crafted with .NET &amp; Statiq.Web</span></div></footer>
  </div>
</body>
</html>
