@{
    var siteTitle = Context.Settings.GetString("Title") ?? "DevTalks by Garib Tigranyan";
    var title = Document.GetString("Title") ?? "Engineering Notes";
    var description = Document.GetString("Description") ?? Context.Settings.GetString("Description") ?? "Practical .NET and architecture writing.";
    var basePath = (Context.Settings.GetString("SiteBasePath") ?? "").TrimEnd('/');
    var path = Document.GetString("Permalink") ?? "";
    var fullTitle = title == "Home" ? siteTitle : $"{title} · Garib Tigranyan";
}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#080f1c" />
  <meta name="description" content="@description" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content="@fullTitle" />
  <meta property="og:description" content="@description" />
  <meta property="og:site_name" content="@siteTitle" />
  <title>@fullTitle</title>
  <link rel="icon" href="@(basePath)/assets/favicon.ico?v=violet" sizes="16x16 32x32 48x48" />
  <link rel="icon" type="image/svg+xml" href="@(basePath)/assets/favicon.svg?v=violet" />
  <link rel="apple-touch-icon" sizes="180x180" href="@(basePath)/assets/apple-touch-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="@(basePath)/assets/css/site.css?v=violet" />
  <script src="@(basePath)/assets/js/site.js" defer></script>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <div class="site-wrap">
    <header class="site-header">
      <div class="container header-content">
        <a class="logo" href="@(basePath)/" aria-label="DevTalks by Garib Tigranyan home"><img src="@(basePath)/assets/devtalks-logo.svg?v=violet" alt="DevTalks by Garib Tigranyan" width="260" height="62" /></a>
        <button class="menu-toggle" type="button" aria-controls="primary-nav" aria-expanded="false" aria-label="Toggle navigation"><span></span><span></span><span></span></button>
        <nav id="primary-nav" class="nav" aria-label="Primary navigation">
          <a href="@(basePath)/">Home</a>
          <a href="@(basePath)/blog/">Articles</a>
          <a href="@(basePath)/projects/">Projects</a>
          <a href="@(basePath)/about/">About</a>
          <a class="nav-social" href="https://www.youtube.com/%40GaribTigranyan" target="_blank" rel="noopener noreferrer">YouTube <span aria-hidden="true">↗</span></a>
        </nav>
      </div>
    </header>
    <main id="main">@RenderBody()</main>
    <footer class="site-footer">
      <div class="container footer-top">
        <div><a class="logo" href="@(basePath)/" aria-label="DevTalks by Garib Tigranyan home"><img src="@(basePath)/assets/devtalks-logo.svg?v=violet" alt="DevTalks by Garib Tigranyan" width="260" height="62" /></a><p>Architecture, code, and the decisions behind reliable software.</p></div>
        <div class="footer-navigation"><a href="@(basePath)/blog/">Articles</a><a href="@(basePath)/projects/">Projects</a><a href="@(basePath)/about/">About</a><a href="https://www.youtube.com/%40GaribTigranyan" target="_blank" rel="noopener noreferrer">YouTube ↗</a></div>
      </div>
      <div class="container footer-bottom"><span>© @DateTime.UtcNow.Year Garib Tigranyan. All rights reserved.</span><span>Built with .NET &amp; Statiq Web</span></div>
    </footer>
  </div>
</body>
</html>
