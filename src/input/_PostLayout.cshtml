@{
    Layout = "/_Layout.cshtml";
    var root = (Context.Settings.GetString("SiteBasePath") ?? "/dev-blog-garib").TrimEnd('/');
    var title = Document.GetString("Title") ?? "Article";
    var description = Document.GetString("Description") ?? "";
    var category = Document.GetString("Category") ?? "ENGINEERING";
    var reading = Document.GetString("ReadingTime") ?? "5 min read";
}
<div class="container article-page">
  <nav class="breadcrumb" aria-label="Breadcrumb"><a href="@(root)/">Home</a><span>›</span><a href="@(root)/blog/">Articles</a><span>›</span><span>@category</span></nav>
  <header class="post-heading"><span class="pill article-pill"><span class="pill-dot"></span> @category · @reading</span><h1>@title</h1><p class="lead">@description</p><div class="post-byline"><span class="avatar-initials">GT</span><span><strong>Garib Tigranyan</strong><small>Tech Lead · Senior .NET Developer</small></span></div></header>
  <div class="post-layout"><article class="article-content" id="article-body">@RenderBody()</article><aside class="article-sidebar"><div class="sidebar-box"><span class="kicker">ABOUT THE AUTHOR</span><strong>Engineering from experience.</strong><p>Practical insights on .NET, design, and reliability.</p><a class="text-link" href="@(root)/about/">About me ↗</a></div><div class="sidebar-box"><span class="kicker">MORE ENGINEERING NOTES</span><a href="@(root)/blog/">Browse all articles ↗</a></div></aside></div>
  <div class="post-end"><div><span class="kicker">KEEP EXPLORING</span><h2>Keep building better systems.</h2><p>More practical .NET articles and tutorials are waiting for you.</p></div><a class="btn btn-primary" href="@(root)/blog/">Browse articles ↗</a></div>
</div>
