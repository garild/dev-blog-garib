@{
    Layout = "_Layout.cshtml";
    var root = (Context.Settings.GetString("SiteBasePath") ?? "").TrimEnd('/');
    var title = Document.GetString("Title") ?? "Article";
    var description = Document.GetString("Description") ?? "";
    var category = Document.GetString("Category") ?? "ENGINEERING";
    var reading = Document.GetString("ReadingTime") ?? "5 min read";
}
<div class="container article-page">
 <nav class="breadcrumb" aria-label="Breadcrumb"><a href="@(root)/">Home</a><span>/</span><a href="@(root)/blog/">Articles</a><span>/</span><span>@category</span></nav>
 <header class="post-heading"><span class="eyebrow"><span class="pulse-dot"></span> @category · @reading</span><h1>@title<span class="accent-dot">.</span></h1><p class="lead">@description</p><div class="post-byline"><span class="avatar-initials">GT</span><span><strong>Garib Tigranyan</strong><small>Tech Lead · Senior .NET Developer</small></span></div></header>
 <div class="post-layout"><article class="article-content" id="article-body">@RenderBody()</article><aside class="article-sidebar"><div class="sidebar-box"><span class="kicker">ABOUT THE AUTHOR</span><strong>Engineering from experience.</strong><p>Practical .NET, systems design, and production lessons.</p><a class="text-link" href="@(root)/about/">About me ↗</a></div><div class="sidebar-box"><span class="kicker">MORE WRITING</span><a href="@(root)/blog/">Browse all articles →</a></div></aside></div>
 <div class="post-end"><strong>Enjoyed this article?</strong><p>Explore more practical engineering notes or watch bite-sized lessons.</p><a class="btn btn-primary" href="@(root)/blog/">More articles ↗</a><a class="btn btn-outline" href="https://www.youtube.com/%40GaribTigranyan" target="_blank" rel="noopener noreferrer">YouTube ↗</a></div>
</div>
